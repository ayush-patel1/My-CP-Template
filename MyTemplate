ll gcd(ll a, ll b) { return b ? gcd(b, a % b) : a; }
ll lcm(ll a, ll b) { return a / gcd(a,b) * b; }
ll mod_exp(ll base, ll exp, ll m) { ll res = 1; while (exp) { if (exp & 1) res = res * base % m; base = base * base % m; exp >>= 1; } return res; }
ll mod_inv(ll a) { return mod_exp(a, mod - 2, mod); }

// Binary search helper
template <typename T> int uppr_bound(vector<T>& a, T x) {
  int l = 0, r = sz(a) - 1, res = -1;
  while (l <= r) {
    int m = l + (r - l) / 2;
    if (a[m] <= x) res = m, l = m + 1; else r = m - 1;
  }
  return res;
}

// DSU (Disjoint Set Union)
struct DSU {
  vi parent, size;
  DSU(int n) { parent.resize(n+1); size.assign(n+1, 1); iota(all(parent), 0); }
  int find(int x) { return parent[x] = (parent[x] == x ? x : find(parent[x])); }
  bool unite(int x, int y) {
    x = find(x); y = find(y);
    if (x == y) return false;
    if (size[x] < size[y]) swap(x, y);
    parent[y] = x;
    size[x] += size[y];
    return true;
  }
};

